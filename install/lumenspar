#!/bin/sh
# Lumenspar launcher. The project is run from its source tree rather than
# installed, so put it on PYTHONPATH before handing off to the module.
LUMENSPAR_HOME="${LUMENSPAR_HOME:-$HOME/lumenspar}"
if [ ! -d "$LUMENSPAR_HOME/lumenspar" ]; then
    echo "lumenspar: cannot find the project at $LUMENSPAR_HOME" >&2
    echo "set LUMENSPAR_HOME to its directory" >&2
    exit 1
fi
export PYTHONPATH="$LUMENSPAR_HOME${PYTHONPATH:+:$PYTHONPATH}"
exec python3 -m lumenspar "$@"
